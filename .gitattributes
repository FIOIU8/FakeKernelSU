# Normalize line endings: keep LF in the repository, let Git handle checkout
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
*.zip binary
*.so binary
